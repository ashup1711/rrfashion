# ── RR FASHION — Backend Environment Variables (Example) ──
# Copy this file to .env and fill in your values.
# SEC-18: placeholders only — never commit real secrets.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rr_fashion?schema=public"

# Application
PORT=3000
NODE_ENV=development

# JWT Secrets (REQ-SEC-003 / SEC-18: production startup FAILS if these equal the
# in-code dev fallbacks 'rr-fashion-jwt-secret-dev' / 'rr-fashion-admin-jwt-secret-dev')
JWT_SECRET=change-me
JWT_ADMIN_SECRET=change-me
JWT_EXPIRES_IN=15m
JWT_ADMIN_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# OTP hashing secret (REQ-SEC-003: production startup FAILS if this equals the
# dev fallback 'rr-fashion-otp-secret')
AUTH_OTP_HASH_SECRET=change-me
AUTH_OTP_TTL_MS=600000

# Rate limiting (REQ-SEC-002 / SEC-10) — Redis-backed, per-pod safe
RATE_LIMIT_GENERAL=120
RATE_LIMIT_AUTH=10
RATE_LIMIT_UPLOAD=20
RATE_LIMIT_GUEST=20

# JSON body size limit (bytes) (REQ-SEC-011 / SEC-11)
BODY_LIMIT_JSON=1048576

# Upload size caps (bytes) (REQ-BE-013 / REQ-BE-014) — per-route env-driven limits
UPLOAD_MAX_FILE_SIZE_BYTES=5242880
UPLOAD_MAX_PROFILE_SIZE_BYTES=2097152

# Pwned-passwords (HIBP) breach check (REQ-BE-011) — disable only for offline dev
HIBP_ENABLED=true

# Daily stock reconciliation cron (cron expression, IST 03:00 default) (REQ-BE-015)
STOCK_RECON_CRON=0 30 3 * * *

# Swagger UI — only served in production when SWAGGER_ENABLED=true (REQ-SEC-009 / SEC-13)
SWAGGER_ENABLED=false

# CORS origins — comma-separated extra origins appended to the allow-list (REQ-SEC-013 / SEC-02)
# CORS_ORIGINS=https://shop.mydomain.com

# Guest session lifecycle
GUEST_SESSION_TTL_DAYS=30

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO (S3-compatible object storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=rrfashion
MINIO_USE_SSL=false

# Mail (Nodemailer)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASS=
MAIL_FROM=noreply@rrfashion.com

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# REQ-BE-004: cart abandonment scan cron expression (every 6 hours default)
CART_ABANDONMENT_CRON=0 */6 * * *
