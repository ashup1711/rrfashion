// ══════════════════════════════════════════════════════════
//  RENTALS
// ══════════════════════════════════════════════════════════

model RentalBooking {
  id                 String                    @id @default(uuid())
  orderItemId        String
  orderItem          OrderItem                 @relation(fields: [orderItemId], references: [id])
  unitId             String
  unit               InventoryUnit             @relation(fields: [unitId], references: [id])
  storeId            String
  store              StoreLocation             @relation(fields: [storeId], references: [id])
  status             RentalBookingStatus       @default(BOOKED)
  bookedAt           DateTime                  @default(now())
  pickupAt           DateTime?
  dueReturnAt        DateTime
  bookingPeriod      Unsupported("tstzrange")? @map("booking_period")
  actualReturnAt     DateTime?
  inspectedAt        DateTime?
  inspectedByAdminId String?
  inspectedBy        AdminUser?                @relation("RentalInspector", fields: [inspectedByAdminId], references: [id])
  depositAmount      Decimal                   @db.Decimal(12, 2)
  depositStatus      String                    @default("collected")
  razorpayPreAuthId  String?
  preAuthStatus      String?
  lateFee            Decimal                   @default(0) @db.Decimal(12, 2)
  damageCharge       Decimal                   @default(0) @db.Decimal(12, 2)
  damageNotes        String?
  damagePhotos       String[]
  closeNotes         String?

  // ── Damage assessment / inspection workflow — Phase 2 (REQ-DB-012) ──
  // Option A (locked by research report §3.2): the inspection lives ON
  // RentalBooking. There is deliberately NO separate RentalInspection
  // table — the existing damageCharge/damageNotes/damagePhotos/inspectedAt/
  // inspectedByAdminId columns already hold in-flight damage data, and a
  // 1:1 split would require migrating that data and would fork the source
  // of truth.
  //
  // All columns are nullable: bookings created before this migration have
  // no inspection, and an inspection is only ever partially filled until
  // the admin completes it (REQ-BE-031).
  //
  // conditionBefore/conditionAfter : photo URLs or condition tags captured
  //                                  at pickup vs. return.
  // damageChecklist                : structured admin checklist
  //                                  ({ stains, tears, missingParts, odor }).
  // damageFindings                 : free-text narrative of the findings.
  // estimatedRepairCost            : admin's estimate before the rule engine.
  // finalCharge                    : authoritative amount computed by the
  //                                  damage rule engine (REQ-BE-033).
  //                                  Supersedes damageCharge, which is kept
  //                                  for one release for backwards compat.
  // customerNotifiedAt             : starts the 48h dispute window (REQ-BE-032).
  // customerDisputedAt             : set when the customer disputes in-window.
  // disputeResolvedAt              : set when an admin resolves the dispute.
  conditionBefore     String[]  @map("condition_before")
  conditionAfter      String[]  @map("condition_after")
  damageChecklist     Json?     @map("damage_checklist")
  damageFindings      String?   @map("damage_findings") @db.Text
  estimatedRepairCost Decimal?  @map("estimated_repair_cost") @db.Decimal(12, 2)
  finalCharge         Decimal?  @map("final_charge") @db.Decimal(12, 2)
  customerNotifiedAt  DateTime? @map("customer_notified_at")
  customerDisputedAt  DateTime? @map("customer_disputed_at")
  disputeResolvedAt   DateTime? @map("dispute_resolved_at")

  extensions RentalExtension[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([unitId])
  @@index([status])
  // REQ-DB-012 — 48h dispute-window sweep: notified but not yet disputed.
  @@index([customerNotifiedAt])
  // REQ-DB-012 — admin "open disputes" queue: disputed, not yet resolved.
  @@index([customerDisputedAt, disputeResolvedAt])
  @@map("rental_bookings")
}

model RentalExtension {
  id                String        @id @default(uuid())
  rentalBookingId   String
  rentalBooking     RentalBooking @relation(fields: [rentalBookingId], references: [id])
  originalDueDate   DateTime
  newDueDate        DateTime
  additionalCharge  Decimal       @db.Decimal(12, 2)
  paymentId         String?
