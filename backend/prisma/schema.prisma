// ─────────────────────────────────────────────────────────
//  RR FASHION — Prisma Schema (PostgreSQL)
//  Phase 1 Foundation: Full schema overhaul
//  Models: User, Category, Brand, Product, ProductVariant,
//          ProductImage, ProductTag, Review, StoreLocation,
//          Order, OrderItem, Cart, CartItem, InventoryUnit,
//          InventorySummary, InventoryLock, StockMovement,
//          AdminUser, RoleModel, Permission, RolePermission,
//          RefreshToken, AuditLog, SizeGuide
// ─────────────────────────────────────────────────────────

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ══════════════════════════════════════════════════════════
//  ENUMS
// ══════════════════════════════════════════════════════════

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  PARTIALLY_CANCELLED
  RETURNED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentType {
  SALE_PAYMENT
  RENTAL_CHARGE
  SECURITY_DEPOSIT
  DEPOSIT_REFUND
  LATE_FEE
  DAMAGE_CHARGE
  REFUND
}

enum PaymentChannel {
  ONLINE
  OFFLINE
}

enum PaymentMethod {
  CARD
  UPI
  NETBANKING
  WALLET
  CASH
  POS_CARD
}

enum OrderChannel {
  ONLINE
  OFFLINE
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
}

enum ImageSizeType {
  THUMBNAIL
  MEDIUM
  LARGE
  ORIGINAL
}

enum ImageVariantType {
  ORIGINAL
  MEDIUM
  THUMBNAIL
}

enum InventoryUnitStatus {
  AVAILABLE
  RESERVED
  RENTED_OUT
  SOLD
  DAMAGED
  IN_WASH
  UNDER_REPAIR
  LOST
}

enum InventoryLockStatus {
  ACTIVE
  RELEASED
  EXPIRED
}

enum ReportStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum StockMovementType {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
  MANUAL
  TRANSFER_IN
  TRANSFER_OUT
  LOCK
  UNLOCK
  RESERVATION
  SALE_FINAL
}

enum RentalBookingStatus {
  BOOKED
  IN_USE
  RETURNED
  INSPECTED
  CLOSED
  LATE_RETURN
  DAMAGE_ASSESSED
  UNDER_REPAIR
  CANCELLED
}

enum InvoiceType {
  INVOICE
  CREDIT_NOTE
  SUPPLEMENTARY_INVOICE
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum CouponType {
  PERCENT
  FLAT
}

enum CouponAppliesTo {
  ALL
  SALE
  RENT
}

// Phase 1 Batch 1A — New enums (REQ-DB-001, 002, 005, 006, 007)

enum CancellationReason {
  CUSTOMER_REQUEST
  BUYER_REMORSE
  WRONG_ITEM
  FOUND_BETTER_PRICE
  NOT_NEEDED
  OUT_OF_STOCK
  FRAUD
  ADMIN_OVERRIDE
  OTHER
}

enum ActorType {
  USER
  ADMIN
  SYSTEM
  GUEST
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum ReturnReason {
  SIZE_ISSUE
  DEFECT
  WRONG_ITEM
  CHANGED_MIND
  OTHER
}

enum ReturnItemStatus {
  PENDING
  APPROVED
  REJECTED
  RECEIVED
  REFUNDED
}

enum RefundStatus {
  INITIATED
  PROCESSED
  FAILED
}

// ══════════════════════════════════════════════════════════
//  USER & AUTH
// ══════════════════════════════════════════════════════════

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String
  firstName       String
  lastName        String
  phone           String?
  role            Role      @default(CUSTOMER)
  addresses       Json?
  isGuest         Boolean   @default(false)
  isPhoneVerified Boolean   @default(false)
  isEmailVerified Boolean   @default(false)
  isActive        Boolean   @default(true)
  deletedAt       DateTime?

  profilePhoto    String? // URL of the user's profile photo
  profilePhotoKey String? // Storage key for the profile photo (used for deletion/re-upload)

  orders             Order[]
  userAddresses      UserAddress[]
  reviews            Review[]
  cart               Cart?
  refreshTokens      RefreshToken[]
  wishlists          Wishlist[]
  notifications      Notification[]
  walletTransactions WalletTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([phone])
  @@index([deletedAt])
  @@map("users")
}

model UserAddress {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String   @default("Home")
  line1     String   @map("line1")
  line2     String?  @map("line2")
  city      String   @map("city")
  state     String   @map("state")
  pincode   String   @map("pincode")
  phone     String?  @map("phone")
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([userId, isDefault])
  @@map("user_addresses")
}

model RefreshToken {
  id          String     @id @default(uuid())
  token       String     @unique
  userId      String?
  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminUserId String?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  userAgent   String?
  isRevoked   Boolean    @default(false)
  expiresAt   DateTime
  createdAt   DateTime   @default(now())

  @@index([userId])
  @@index([adminUserId])
  @@index([token])
  @@map("refresh_tokens")
}

// ══════════════════════════════════════════════════════════
//  OTP VERIFICATION
// ══════════════════════════════════════════════════════════

model OtpVerification {
  id        String   @id @default(uuid())
  phone     String
  otpHash   String
  purpose   String
  verified  Boolean  @default(false)
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone, purpose])
  @@map("otp_verifications")
}

model ProcessedWebhookEvent {
  id        String   @id @default(cuid())
  eventId   String   @unique @map("event_id")
  eventType String   @map("event_type")
  payload   Json     @map("payload")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([eventType, createdAt])
  @@map("processed_webhook_events")
}

// ══════════════════════════════════════════════════════════
//  PRODUCT CATALOG — Category, Brand, Product, Variant, Image, Tag
// ══════════════════════════════════════════════════════════

model Category {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?
  image       String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id])

  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")

  products   Product[]
  sizeGuides SizeGuide[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([brandId])
  @@index([slug])
  @@map("categories")
}

model Brand {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  isActive    Boolean @default(true)

  products   Product[]
  categories Category[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("brands")
}

model Product {
  id               String    @id @default(uuid())
  name             String
  slug             String    @unique
  description      String?
  basePrice        Decimal   @db.Decimal(12, 2)
  salePrice        Decimal?  @db.Decimal(12, 2)
  images           String[]
  stock            Int       @default(0)
  version          Int       @default(0)
  isFeatured       Boolean   @default(false)
  isActive         Boolean   @default(true)
  fabric           String?
  hsnCode          String?
  isRentable       Boolean   @default(false)
  isSellable       Boolean   @default(true)
  careInstructions String?
  sortPriority     Int       @default(0)
  deletedAt        DateTime?

  // ── SEO metadata — Phase 2 (REQ-DB-011) ──────────────────
  // All optional; consumed by GET /api/seo/product/:slug (REQ-BE-030),
  // sitemap.xml (REQ-BE-029) and the storefront <head> (REQ-FE-007).
  // Public, non-PII data. Falls back to name/description when null.
  metaTitle       String? @map("meta_title") @db.VarChar(160)
  metaDescription String? @map("meta_description") @db.VarChar(320)
  ogImage         String? @map("og_image") @db.Text
  canonicalUrl    String? @map("canonical_url") @db.Text

  // ── Full-text search — Phase 2 (REQ-DB-009) ──────────────
  // searchKeywords: denormalized "key value" text of this product's
  //   ProductTag rows. Maintained ONLY by the DB trigger
  //   product_tags_search_sync_trg (see the phase 2 migration).
  //   DO NOT write to this column from application code.
  // searchVector: PostgreSQL tsvector, GENERATED ALWAYS AS STORED from
  //   name (weight A) + searchKeywords (weight B) + description (weight C).
  //   Prisma cannot model tsvector natively -> Unsupported(). It is
  //   read-only for the app; query it with raw SQL
  //   (websearch_to_tsquery + ts_rank) per REQ-BE-017.
  searchKeywords String?                  @map("search_keywords") @db.Text
  // @default(dbgenerated()) tells Prisma the value is produced by the
  // database (the GENERATED ALWAYS AS ... STORED expression) so `prisma
  // migrate diff` does not see phantom drift and try to DROP DEFAULT.
  searchVector   Unsupported("tsvector")? @default(dbgenerated()) @map("search_vector")

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id])

  variants                    ProductVariant[]
  tags                        ProductTag[]
  reviews                     Review[]
  orderItems                  OrderItem[]
  cartItems                   CartItem[]
  guestCartItems              GuestCartItem[]
  inquiries                   Inquiry[]
  inventoryReconciliationLogs InventoryReconciliationLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([brandId])
  @@index([isFeatured])
  @@index([slug])
  @@index([deletedAt])
  @@index([isActive, deletedAt, salePrice])
  // REQ-DB-009 — full-text search index over the generated tsvector.
  @@index([searchVector], map: "products_search_idx", type: Gin)
  // REQ-DB-009 — fuzzy / typo-tolerant matching on name (pg_trgm `%` and
  // similarity()). Requires the pg_trgm extension (created in the migration).
  @@index([name(ops: raw("gin_trgm_ops"))], map: "products_name_trgm_idx", type: Gin)
  @@map("products")
}

model ProductVariant {
  id              String    @id @default(uuid())
  productId       String
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  size            String
  color           String
  sku             String    @unique
  barcode         String?   @unique
  salePrice       Decimal?  @db.Decimal(12, 2)
  rentPricePerDay Decimal?  @db.Decimal(12, 2)
  securityDeposit Decimal?  @db.Decimal(12, 2)
  weightGrams     Int?
  isActive        Boolean   @default(true)
  deletedAt       DateTime?

  images                      ProductImage[]
  inventoryUnits              InventoryUnit[]
  inventorySummaries          InventorySummary[]
  inventoryLocks              InventoryLock[]
  stockMovements              StockMovement[]
  orderItems                  OrderItem[]
  cartItems                   CartItem[]
  guestCartItems              GuestCartItem[]
  reviews                     Review[]
  wishlists                   Wishlist[]
  guestWishlistItems          GuestWishlistItem[]
  inventoryReconciliationLogs InventoryReconciliationLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([sku])
  @@index([deletedAt])
  @@map("product_variants")
}

model ProductImage {
  id            String           @id @default(uuid())
  variantId     String
  variant       ProductVariant   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  url           String
  storageKey    String?          @map("storage_key")
  altText       String?
  sortOrder     Int              @default(0)
  width         Int?
  height        Int?
  fileSize      Int              @default(0) @map("file_size")
  mimeType      String           @default("image/webp") @map("mime_type")
  variantType   ImageVariantType @default(ORIGINAL) @map("variant_type")
  parentImageId String?          @map("parent_image_id")
  parentImage   ProductImage?    @relation("ImageVariants", fields: [parentImageId], references: [id], onDelete: Cascade)
  variants      ProductImage[]   @relation("ImageVariants")

  createdAt DateTime @default(now())

  @@unique([storageKey])
  @@index([variantId])
  @@index([storageKey])
  @@index([parentImageId])
  @@index([variantId, variantType])
  @@map("product_images")
}

model ProductTag {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  key       String
  value     String

  @@unique([productId, key, value])
  @@map("product_tags")
}

model SizeGuide {
  id               String   @id @default(uuid())
  categoryId       String
  category         Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  measurementsJson Json?
  imageUrl         String?
  createdAt        DateTime @default(now())

  @@index([categoryId])
  @@map("size_guides")
}

// ══════════════════════════════════════════════════════════
//  REVIEWS
// ══════════════════════════════════════════════════════════

model Review {
  id      String       @id @default(uuid())
  rating  Int
  comment String?
  photos  String[]
  status  ReviewStatus @default(PENDING)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  guestSessionId String?       @map("guest_session_id")
  guestSession   GuestSession? @relation(fields: [guestSessionId], references: [id], onDelete: SetNull)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  orderItemId String?    @map("order_item_id")
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  reviewedByAdminId String?
  reviewedBy        AdminUser? @relation(fields: [reviewedByAdminId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([userId])
  @@index([guestSessionId])
  @@index([productId])
  @@index([variantId])
  @@index([orderItemId])
  @@index([status])
  @@map("reviews")
}

// ══════════════════════════════════════════════════════════
//  STORE LOCATION
// ══════════════════════════════════════════════════════════

model StoreLocation {
  id       String  @id @default(uuid())
  name     String
  address  String
  city     String?
  state    String
  pincode  String?
  gstin    String
  phone    String?
  isActive Boolean @default(true)

  orders             Order[]
  invoices           Invoice[]
  inventoryUnits     InventoryUnit[]
  inventorySummaries InventorySummary[]
  inventoryLocks     InventoryLock[]
  stockMovements     StockMovement[]
  rentalBookings     RentalBooking[]

  createdAt DateTime @default(now())

  @@map("store_locations")
}

// ══════════════════════════════════════════════════════════
//  ORDER & CART
// ══════════════════════════════════════════════════════════

model Order {
  id                 String              @id @default(uuid())
  orderNumber        String              @unique
  userId             String?
  user               User?               @relation(fields: [userId], references: [id])
  guestSessionId     String?             @map("guest_session_id")
  guestSession       GuestSession?       @relation(fields: [guestSessionId], references: [id], onDelete: SetNull)
  userType           String?             @default("customer")
  adminUserId        String?
  adminUser          AdminUser?          @relation(fields: [adminUserId], references: [id])
  status             OrderStatus         @default(PENDING)
  totalAmount        Decimal             @db.Decimal(12, 2)
  subtotal           Decimal             @db.Decimal(12, 2)
  discountAmount     Decimal             @default(0) @db.Decimal(12, 2)
  shippingCharge     Decimal             @default(0) @db.Decimal(12, 2)
  version            Int                 @default(0)
  taxAmount          Decimal             @default(0) @db.Decimal(12, 2)
  shippingAddress    Json?
  paymentMethod      String?
  paymentStatus      PaymentStatus       @default(PENDING)
  channel            String              @default("online")
  couponId           String?
  notes              String?
  cancelledAt        DateTime?
  cancelledBy        String?             @map("cancelled_by")
  cancellationReason CancellationReason? @map("cancellation_reason")
  deliveredAt        DateTime?

  storeId String?
  store   StoreLocation? @relation(fields: [storeId], references: [id])

  items             OrderItem[]
  statusLogs        OrderStatusLog[]
  payments          Payment[]
  invoices          Invoice[]
  shippingAddresses ShippingAddress[]
  courierReceipts   CourierReceipt[]
  returnRequests    ReturnRequest[]
  refunds           Refund[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([guestSessionId])
  @@index([status])
  @@index([storeId])
  @@index([orderNumber])
  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([guestSessionId, createdAt])
  @@index([adminUserId])
  @@map("orders")
}

model OrderStatusLog {
  id         String     @id @default(uuid())
  orderId    String     @map("order_id")
  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus String     @map("from_status")
  toStatus   String     @map("to_status")
  changedBy  String?    @map("changed_by")
  note       String?    @map("note")
  actorType  ActorType? @map("actor_type")
  reason     String?    @map("reason")
  metadata   Json?      @map("metadata")
  createdAt  DateTime   @default(now()) @map("created_at")

  @@index([orderId])
  @@index([orderId, createdAt])
  @@index([actorType])
  @@map("order_status_logs")
}

model OrderItem {
  id            String          @id @default(uuid())
  orderId       String
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String
  product       Product         @relation(fields: [productId], references: [id])
  variantId     String?
  variant       ProductVariant? @relation(fields: [variantId], references: [id])
  quantity      Int
  unitPrice     Decimal         @db.Decimal(12, 2)
  totalPrice    Decimal         @db.Decimal(12, 2)
  subtotal      Decimal         @db.Decimal(12, 2)
  unitId        String?
  type          String          @default("sale")
  hsnCode       String?
  taxRate       Decimal?        @db.Decimal(5, 2)
  cgstAmount    Decimal?        @db.Decimal(12, 2)
  sgstAmount    Decimal?        @db.Decimal(12, 2)
  igstAmount    Decimal?        @db.Decimal(12, 2)
  depositAmount Decimal?        @db.Decimal(12, 2)
  rentStart     DateTime?
  rentEnd       DateTime?
  rentDays      Int?
  status        String          @default("confirmed")

  rentalBookings     RentalBooking[]
  reviews            Review[]
  returnRequestItems ReturnRequestItem[]

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}

model Cart {
  id             String     @id @default(uuid())
  userId         String?    @unique
  user           User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestSessionId String?    @unique @map("guest_session_id")
  items          CartItem[]

  abandonedAt DateTime? @map("abandoned_at")
  recoveredAt DateTime? @map("recovered_at")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
  @@index([abandonedAt])
  @@map("carts")
}

model CartItem {
  id            String          @id @default(uuid())
  cartId        String
  cart          Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId     String
  product       Product         @relation(fields: [productId], references: [id])
  variantId     String?
  variant       ProductVariant? @relation(fields: [variantId], references: [id])
  quantity      Int             @default(1)
  type          String          @default("sale")
  rentStart     DateTime?
  rentEnd       DateTime?
  addedAt       DateTime        @default(now()) @map("added_at")
  priceSnapshot Decimal?        @map("price_snapshot") @db.Decimal(12, 2)

  @@index([cartId])
  @@index([productId])
  @@index([variantId])
  @@index([cartId, addedAt])
  @@map("cart_items")
}

// ══════════════════════════════════════════════════════════
//  SHIPPING
// ══════════════════════════════════════════════════════════

model ShippingAddress {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  name    String
  phone   String
  line1   String
  line2   String?
  city    String
  state   String
  pincode String
  country String  @default("IND")

  @@index([orderId])
  @@map("shipping_addresses")
}

model CourierReceipt {
  id               String     @id @default(uuid())
  orderId          String
  order            Order      @relation(fields: [orderId], references: [id])
  courierName      String
  awbNumber        String
  trackingUrl      String?
  receiptFileUrl   String?
  source           String     @default("manual")
  enteredByAdminId String?
  receivedBy       AdminUser? @relation("CourierEntry", fields: [enteredByAdminId], references: [id])
  shippedAt        DateTime?
  deliveredAt      DateTime?
  createdAt        DateTime   @default(now())

  @@index([orderId])
  @@map("courier_receipts")
}

// ══════════════════════════════════════════════════════════
//  INVENTORY
// ══════════════════════════════════════════════════════════

model InventoryUnit {
  id             String         @id @default(uuid())
  variantId      String
  variant        ProductVariant @relation(fields: [variantId], references: [id])
  storeId        String
  store          StoreLocation  @relation(fields: [storeId], references: [id])
  status         String         @default("available")
  conditionNotes String?

  rentalBookings RentalBooking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([variantId, storeId])
  @@index([status])
  @@map("inventory_units")
}

model InventorySummary {
  variantId         String
  variant           ProductVariant @relation(fields: [variantId], references: [id])
  storeId           String
  store             StoreLocation  @relation(fields: [storeId], references: [id])
  quantityAvailable Int            @default(0)
  quantityReserved  Int            @default(0)
  quantityLocked    Int            @default(0)
  quantitySold      Int            @default(0)
  lowStockThreshold Int            @default(5)

  updatedAt DateTime @updatedAt

  @@id([variantId, storeId])
  @@map("inventory_summary")
}

model InventoryLock {
  id              String         @id @default(uuid())
  variantId       String
  variant         ProductVariant @relation(fields: [variantId], references: [id])
  storeId         String
  store           StoreLocation  @relation(fields: [storeId], references: [id])
  lockedByAdminId String?
  lockedBy        AdminUser?     @relation(fields: [lockedByAdminId], references: [id])
  deviceId        String?
  clientUuid      String
  reason          String?
  quantity        Int            @default(1)
  orderId         String?        @map("order_id")
  status          String         @default("active")
  lockedAt        DateTime       @default(now())
  expiresAt       DateTime
  releasedAt      DateTime?
  createdAt       DateTime       @default(now())

  @@index([variantId, storeId, status])
