// ══════════════════════════════════════════════════════════
//  RETURNS — Phase 1 Batch 1A (REQ-DB-005, REQ-DB-006)
//  ReturnRequest: a customer-facing request to return one or
//  more OrderItems. ReturnRequestItem: one line item per
//  ReturnRequest, referencing the original OrderItem. Both are
//  PII-adjacent: adminNotes and notes may contain free text
//  from customers or staff — handle per SEC-13.
// ══════════════════════════════════════════════════════════

model ReturnRequest {
  id         String       @id @default(uuid())
  orderId    String       @map("order_id")
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status     ReturnStatus @default(PENDING)
  adminNotes String?      @map("admin_notes") @db.Text
  resolvedAt DateTime?    @map("resolved_at")

  items   ReturnRequestItem[]
  refunds Refund[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([orderId, createdAt])
  @@index([status])
  @@index([orderId, status])
  @@map("return_requests")
}

model ReturnRequestItem {
  id              String           @id @default(uuid())
  returnRequestId String           @map("return_request_id")
  returnRequest   ReturnRequest    @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItemId     String           @map("order_item_id")
  orderItem       OrderItem        @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  quantity        Int
  reason          ReturnReason
  photos          String[]         @map("photos")
  notes           String?          @map("notes") @db.Text
  status          ReturnItemStatus @default(PENDING)
  refundAmount    Decimal?         @map("refund_amount") @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([returnRequestId])
  @@index([orderItemId])
  @@index([status])
  @@map("return_request_items")
}

// ══════════════════════════════════════════════════════════
//  REFUNDS — Phase 1 Batch 1A (REQ-DB-007)
//  One Order can have many Refund rows (partial refunds).
//  razorpayRefundId is the canonical Razorpay refund id and is
//  unique to support idempotency on the Refund row.
//  returnRequestId is nullable: refunds can originate outside
//  of a return flow (e.g. order cancellation auto-refund).
//  Data loss note: prior to this migration refund details were
//  not persisted; the payments service only updated
//  Payment.status to REFUNDED/PARTIALLY_REFUNDED.
// ══════════════════════════════════════════════════════════

model Refund {
  id               String         @id @default(uuid())
  orderId          String         @map("order_id")
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  returnRequestId  String?        @map("return_request_id")
  returnRequest    ReturnRequest? @relation(fields: [returnRequestId], references: [id], onDelete: SetNull)
  amount           Decimal        @db.Decimal(12, 2)
  razorpayRefundId String         @unique @map("razorpay_refund_id")
  status           RefundStatus   @default(INITIATED)
  reason           String?        @map("reason") @db.Text
  initiatedAt      DateTime       @default(now()) @map("initiated_at")
  processedAt      DateTime?      @map("processed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // SEC-06: ownership-scoped lookups by orderId; status filter for
  // dashboards; (orderId, status) covers the partial-refund timeline view.
  @@index([orderId])
  @@index([returnRequestId])
  @@index([status])
  @@index([orderId, status])
  @@index([initiatedAt])
  @@map("refunds")
}

// ══════════════════════════════════════════════════════════
//  INVENTORY RECONCILIATION — Phase 1 Batch 1A (REQ-DB-008)
//  Daily cron compares ProductVariant.stock against
//  InventorySummary.quantityAvailable sum; writes a row on
//  mismatch. Distinct from StockAudit (which is for manual
//  physical counts by staff). The (runAt, resolved) index
//  supports the unresolved-recent-mismatches admin dashboard
//  query.
// ══════════════════════════════════════════════════════════

model InventoryReconciliationLog {
  id          String          @id @default(uuid())
  productId   String          @map("product_id")
  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId   String?         @map("variant_id")
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  expectedQty Int             @map("expected_qty")
  actualQty   Int             @map("actual_qty")
  discrepancy Int             @map("discrepancy")
  runAt       DateTime        @default(now()) @map("run_at")
  resolved    Boolean         @default(false)
  resolvedAt  DateTime?       @map("resolved_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([runAt, resolved])
  @@index([productId])
  @@index([variantId])
  @@index([resolved, runAt])
  @@map("inventory_reconciliation_logs")
}

// ══════════════════════════════════════════════════════════
//  SHIPPING RATE CACHE — Phase 2 (REQ-DB-010)
//  Durable 24h cache of carrier rate quotes so POST
//  /api/shipping/calculate-rate (REQ-BE-025) does not hammer the
//  Delhivery/Shiprocket APIs on every checkout page view.
//
//  SEC-13 / SEC-15: this table stores NO user identifier and NO PII —
//  the cache key is (pincode, weight, carrierName) only. A pincode
//  alone is not linked to a person here, so the row is safe to share
//  across users. Never add userId/orderId/phone to this table; do that
//  and the shared cache becomes a cross-user data-leak vector.
//
//  Invalidation: `ttl` is an absolute expiry timestamp (now + 24h,
//  jittered by the service per SEC-15). Readers MUST filter
//  `ttl > now()`; a daily sweep deletes expired rows using the
//  shipping_rate_cache_ttl_idx index.
// ══════════════════════════════════════════════════════════

model ShippingRateCache {
  id            String   @id @default(uuid())
  pincode       String   @db.VarChar(10)
  /// Chargeable weight in kilograms for this quote.
  weight        Decimal  @db.Decimal(10, 2)
  /// Quoted shipping charge. Decimal(12,2) matches the project money
  /// convention (research report §3.5) because this value flows into
  /// Order totals.
  rate          Decimal  @db.Decimal(12, 2)
  carrierName   String   @map("carrier_name") @db.VarChar(64)
  estimatedDays Int?     @map("estimated_days")
  /// Absolute expiry instant for this cached quote (created + 24h).
  ttl           DateTime @map("ttl")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Cache key — one live row per (pincode, weight, carrier); the service
  /// upserts on this target so concurrent quote requests cannot duplicate.
  @@unique([pincode, weight, carrierName], name: "shipping_rate_cache_key")
  /// Required composite lookup index (REQ-DB-010): the read path is
  /// WHERE pincode = $1 AND weight = $2 AND ttl > now().
  @@index([pincode, weight])
  /// Expiry sweep / TTL cleanup job.
  @@index([ttl])
  @@map("shipping_rate_cache")
}
