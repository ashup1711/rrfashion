// REQ-BE-018 — search analytics log.
// Every client search query (REQ-BE-017) is recorded here so the admin
// analytics endpoint can surface popular queries and zero-result queries.
// `text` is length-capped (256) because a user may paste PII (e.g. an email
// or phone) into the search box; SEC-13 — we never persist unbounded PII.
// `normalized` is a lowercased/trimmed copy used as the GROUP BY key in the
// popular-queries aggregation (avoids per-query LOWER() scans).
// `userId` is optional (searches are public); when present it is the store
// customer id from the JWT `sub` claim, never a raw client-supplied value.
// Indexes cover the two read paths: time-window scans (createdAt) and
// popular-query grouping (normalized + createdAt).
model SearchQuery {
  id         String   @id @default(uuid())
  text       String   @db.VarChar(256)
  normalized String   @db.VarChar(256)
  resultCount Int
  userId     String?
  sessionId  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([normalized, createdAt])
  @@map("search_queries")
}

